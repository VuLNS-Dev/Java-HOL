<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="org.vulns.zpayment-PU" transaction-type="RESOURCE_LOCAL">
        <!-- Declare entities for mapping tables in DB -->
        <!--        <class>org.vulns.zpayment.entity.base.TransactionCashDepositSlip</class>-->

        <!-- Config DB connection -->
        <properties>
            <!-- JDBC Driver -->
            <!--
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- JDBC: connection string -->
            <!--
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlserver://localhost:1433;databaseName=zpayment_jpa;encrypt=true;trustServerCertificate=true"/>
            -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/zpayment_jpa"/>

            <!-- Authenticate -->
            <property name="jakarta.persistence.jdbc.user" value="vulns"/>
            <property name="jakarta.persistence.jdbc.password" value="@dm1n"/>

            <!-- Set hibernate provider for connecting to DB -->
            <!--
            <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/>
            -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Optional:
            "none": do not anything
            "validate": check exist tables and entities
            "update": update schema for tables/columns
            "create": delete and create new tables
            "create-drop": create tables when running and drop tables when stopping
            "drop": drop all tables when app start and do not create tables -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Show SQL statements -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
